rules_version = '2';

// Firebase Security Rules for the MPSC PYQ Quiz app.
//
// Deploy with the Firebase CLI from the project root:
//   firebase deploy --only firestore:rules
//
// (Or paste this file's contents into the Firebase Console
//  → Firestore Database → Rules tab.)
//
// Rationale per collection:
//   leaderboard      — public read; only the signed-in author can create
//                      their own entry; integrity-checked (score within
//                      bounds, scorePct matches, dateKey looks like
//                      YYYY-MM-DD and falls within ±1 day of server time).
//                      Append-only.
//   question_reports — public create (matches existing app behavior); read
//                      access kept open for the admin dashboard; resolve and
//                      delete restricted to allow-listed admin accounts.
//   admin_users      — the admin allow-list. Readable only by the admins it
//                      names, which is how the app decides whether to show
//                      the admin UI. Writable only from the Firebase Console.
//   settings         — public read (for live quiz-bundle revision); only
//                      Firebase Console can write.

service cloud.firestore {
  match /databases/{database}/documents {

    // True when the caller is signed in as an allow-listed admin. Declared
    // here rather than at file scope because it needs the {database} binding.
    // Fails closed: an anonymous caller, or a missing `admin_users/config`,
    // yields false.
    function isAdminUser() {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/admin_users/config).data.uids;
    }

    // --- Admin allow-list -----------------------------------------------
    // Single document `admin_users/config` with an array field `uids`
    // holding the Firebase Auth UID of every admin. Create and edit it from
    // the Firebase Console only. An admin can read it (that read is what the
    // app uses to confirm admin status); nobody else can read or write it.
    match /admin_users/config {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.uids;
      allow write: if false; // only Firebase Console
    }

    // --- Leaderboard ----------------------------------------------------
    match /leaderboard/{doc} {
      allow read: if true;

      allow create: if isValidLeaderboardEntry(request.resource.data);

      // Append-only: never edit or delete an existing score.
      allow update, delete: if false;
    }

    // --- Question reports (existing) ------------------------------------
    match /question_reports/{doc} {
      allow read: if true;
      allow create: if request.resource.data.questionId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() < 1000
        && request.resource.data.reporterEmail is string
        && request.resource.data.reporterEmail.size() <= 200;

      // Resolve / delete from the admin panel. Restricted to allow-listed
      // admins so a visitor cannot clear the report queue.
      allow update, delete: if isAdminUser();
    }

    // --- App-wide settings (e.g. quiz_data revision) --------------------
    match /settings/{doc} {
      allow read: if true;
      allow write: if false; // only Firebase Console
    }

    // --- Aspirant progress (attempted IDs, history, streak) --------------
    // Each signed-in student may only read/write their own document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // --- Community feedback (reviews + Reddit-style replies) ------------
    // Public read. Signed-in users create posts/comments as themselves.
    // Admins may create comments with isAdminReply=true (published as
    // "Don't know Academy"). Append-only for normal users.
    function isValidFeedbackPost(d) {
      return request.auth != null
        && d.authorUid == request.auth.uid
        && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 60
        && (d.authorPhoto == null || (d.authorPhoto is string && d.authorPhoto.size() <= 2000))
        && d.title is string && d.title.size() <= 120
        && d.body is string && d.body.size() >= 3 && d.body.size() <= 2000
        && d.createdAt == request.time;
    }

    function isValidFeedbackComment(d) {
      return request.auth != null
        && d.authorUid == request.auth.uid
        && d.body is string && d.body.size() > 0 && d.body.size() <= 1000
        && d.createdAt == request.time
        && d.isAdminReply is bool
        && (
          (
            d.isAdminReply == false
            && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 60
            && (d.authorPhoto == null || (d.authorPhoto is string && d.authorPhoto.size() <= 2000))
          )
          || (
            d.isAdminReply == true
            && isAdminUser()
            && d.authorName == "Don't know Academy"
            && d.authorPhoto == null
          )
        );
    }

    match /feedback_posts/{postId} {
      allow read: if true;
      allow create: if isValidFeedbackPost(request.resource.data);
      allow update, delete: if isAdminUser();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isValidFeedbackComment(request.resource.data);
        allow update, delete: if isAdminUser();
      }
    }
  }
}

// Validation for a single leaderboard entry. Catches:
//   * Wrong user trying to write someone else's score
//   * Out-of-range score / total
//   * Mismatched scorePct (clients must compute it the same way the UI does)
//   * dateKey not in YYYY-MM-DD format (we trust the client to set today)
//   * createdAt not the server timestamp
//   * Missing or oversized strings
function isValidLeaderboardEntry(d) {
  return isValidLeaderboardUser(d.userId)
    && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 60
    && (d.photoURL == null || (d.photoURL is string && d.photoURL.size() <= 500))
    && d.quizId is string && d.quizId.size() > 0 && d.quizId.size() <= 200
    && d.quizTitle is string && d.quizTitle.size() <= 200
    && d.score is int && d.score >= 0
    && d.total is int && d.total > 0 && d.total <= 500
    && d.score <= d.total
    && d.scorePct is int && d.scorePct >= 0 && d.scorePct <= 100
    && d.scorePct == math.round((d.score * 100) / d.total)
    && d.dateKey is string && d.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
    && d.createdAt == request.time;
}

function isValidLeaderboardUser(userId) {
  return userId is string
    && (
      (request.auth != null && userId == request.auth.uid)
      || (request.auth == null && userId.matches('^guest_[A-Za-z0-9_-]{8,80}$'))
    );
}
